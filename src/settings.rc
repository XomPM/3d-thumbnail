#pragma code_page(65001)
#include <windows.h>
#include "settings_ids.h"
IDD_SETTINGS DIALOGEX 0, 0, 460, 374
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "3D Thumbnail 설정"
FONT 9, "Malgun Gothic"
BEGIN
    LTEXT "3D Thumbnail", IDC_BRAND, 49, 13, 278, 28
    LTEXT "탐색기에 표시할 배경과 모델 색상을 바꿔보세요.", IDC_SUBTITLE, 22, 48, 416, 15
    LTEXT "색상 설정", IDC_COLOR_TITLE, 28, 87, 176, 16
    LTEXT "배경", -1, 28, 114, 174, 12
    EDITTEXT IDC_BACKGROUND, 28, 130, 108, 22, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "선택", IDC_PICK_BACKGROUND, "Button", BS_OWNERDRAW | WS_TABSTOP, 145, 130, 66, 22
    LTEXT "모델", -1, 28, 162, 174, 12
    EDITTEXT IDC_MODEL, 28, 178, 108, 22, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "선택", IDC_PICK_MODEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 145, 178, 66, 22
    LTEXT "#RRGGBB · 입체적인 명암은 유지됩니다.", -1, 28, 207, 184, 12
    CONTROL "색상 저장", IDC_SAVE, "Button", BS_OWNERDRAW | WS_TABSTOP, 28, 225, 101, 21
    CONTROL "기본 색상", IDC_DEFAULTS, "Button", BS_OWNERDRAW | WS_TABSTOP, 137, 225, 74, 21
    LTEXT "미리보기", IDC_PREVIEW_TITLE, 248, 87, 172, 16
    CONTROL "모델 미리보기", IDC_PREVIEW, "Static", SS_OWNERDRAW, 248, 111, 184, 122
    LTEXT "저장하면 새 썸네일부터 적용됩니다.", -1, 248, 236, 184, 12, SS_CENTER
    LTEXT "기존 썸네일 갱신", IDC_REFRESH_TITLE, 28, 274, 208, 16
    LTEXT "파일이나 폴더를 선택해 저장한 색상으로 갱신하세요.", -1, 28, 295, 210, 24
    CONTROL "파일 선택…", IDC_REFRESH_FILE, "Button", BS_OWNERDRAW | WS_TABSTOP, 250, 276, 86, 24
    CONTROL "폴더 선택…", IDC_REFRESH_FOLDER, "Button", BS_OWNERDRAW | WS_TABSTOP, 344, 276, 86, 24
    CONTROL "갱신 중단", IDC_CANCEL_REFRESH, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED, 344, 307, 86, 19
    LTEXT "하위 폴더 제외 · 폴더당 최대 1,000개", IDC_STATUS, 28, 319, 304, 14
    LTEXT "DMIND", IDC_CREATOR, 22, 350, 50, 16
    LTEXT "dmind114@gmail.com", IDC_CONTACT, 74, 351, 230, 15
    CONTROL "닫기", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 376, 346, 68, 23
END
