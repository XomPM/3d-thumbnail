#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "settings_ids.h"
IDI_APP ICON "../assets/dmind.ico"

IDD_REFRESH_DETAILS DIALOGEX 0, 0, 440, 240
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "썸네일 갱신 실패 상세"
FONT 9, "맑은 고딕"
BEGIN
    LTEXT "실패 파일과 오류 내용입니다. 아래 내용을 복사해 전달할 수 있습니다.", IDC_ERROR_INTRO, 12, 12, 416, 20
    EDITTEXT IDC_ERROR_TEXT, 12, 36, 416, 164, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON "모두 복사", IDC_COPY_ERRORS, 268, 212, 76, 20
    DEFPUSHBUTTON "닫기", IDOK, 352, 212, 76, 20
END

1 VERSIONINFO
FILEVERSION 1,0,3,0
PRODUCTVERSION 1,0,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName", "DMIND\0"
            VALUE "FileDescription", "3D Thumbnail 설정\0"
            VALUE "FileVersion", "1.0.3\0"
            VALUE "InternalName", "thumbnail-settings\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 DMIND\0"
            VALUE "OriginalFilename", "thumbnail-settings.exe\0"
            VALUE "ProductName", "3D Thumbnail\0"
            VALUE "ProductVersion", "1.0.3\0"
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DMIND\0"
            VALUE "FileDescription", "3D Thumbnail Settings\0"
            VALUE "FileVersion", "1.0.3\0"
            VALUE "InternalName", "thumbnail-settings\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 DMIND\0"
            VALUE "OriginalFilename", "thumbnail-settings.exe\0"
            VALUE "ProductName", "3D Thumbnail\0"
            VALUE "ProductVersion", "1.0.3\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0412, 1200, 0x0409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 460, 384
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "3D Thumbnail 설정"
FONT 9, "Malgun Gothic"
BEGIN
    LTEXT "3D Thumbnail", IDC_BRAND, 50, 11, 240, 18
    LTEXT "탐색기 썸네일의 배경과 모델 색을 정합니다.", IDC_SUBTITLE, 50, 30, 300, 10
    RTEXT "버전 1.0.3", IDC_VERSION, 364, 30, 80, 10

    LTEXT "썸네일 모양", IDC_COLOR_TITLE, 28, 63, 200, 12
    LTEXT "배경 색", IDC_LABEL_BACKGROUND, 28, 88, 56, 10
    CONTROL "배경 색 선택", IDC_PICK_BACKGROUND, "Button", BS_OWNERDRAW | WS_TABSTOP, 88, 84, 16, 16
    EDITTEXT IDC_BACKGROUND, 108, 84, 142, 16, ES_AUTOHSCROLL | ES_UPPERCASE | NOT WS_BORDER | WS_TABSTOP
    LTEXT "배경 투명도", IDC_LABEL_TRANSPARENCY, 28, 114, 56, 10
    CONTROL "배경 투명도", IDC_TRANSPARENCY_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | TBS_BOTH | WS_TABSTOP, 84, 110, 110, 16
    EDITTEXT IDC_TRANSPARENCY, 200, 110, 50, 16, ES_NUMBER | ES_RIGHT | NOT WS_BORDER | WS_TABSTOP
    LTEXT "0%는 불투명, 100%는 배경 없이 모델만 보입니다.", IDC_HELP_TRANSPARENCY, 88, 130, 162, 10
    LTEXT "모델 색", IDC_LABEL_MODEL, 28, 154, 56, 10
    CONTROL "모델 색 선택", IDC_PICK_MODEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 88, 150, 16, 16
    EDITTEXT IDC_MODEL, 108, 150, 142, 16, ES_AUTOHSCROLL | ES_UPPERCASE | NOT WS_BORDER | WS_TABSTOP
    LTEXT "3MF에 제작자가 넣은 썸네일이 있으면 그 이미지를 그대로 보여 줍니다. 없을 때만 이 설정으로 새로 만듭니다.", IDC_NOTE, 28, 188, 222, 28
    CONTROL "기본값", IDC_DEFAULTS, "Button", BS_OWNERDRAW | WS_TABSTOP, 28, 228, 60, 18
    CONTROL "저장", IDC_SAVE, "Button", BS_OWNERDRAW | WS_TABSTOP, 190, 228, 60, 18

    LTEXT "미리보기", IDC_PREVIEW_TITLE, 284, 63, 148, 12
    CONTROL "모델 미리보기", IDC_PREVIEW, "Static", SS_OWNERDRAW, 296, 86, 124, 124
    CTEXT "bearing.stl", IDC_PREVIEW_NAME, 290, 216, 136, 10

    LTEXT "기존 썸네일 갱신", IDC_REFRESH_TITLE, 28, 279, 200, 12
    LTEXT "이미 표시된 썸네일은 저장 후 여기서 다시 만들어야 바뀝니다.", IDC_REFRESH_HELP, 28, 295, 238, 10
    LTEXT "하위 폴더는 포함하지 않으며, 폴더당 최대 1,000개까지 갱신합니다.", IDC_STATUS, 28, 313, 238, 20
    CONTROL "파일 선택…", IDC_REFRESH_FILE, "Button", BS_OWNERDRAW | WS_TABSTOP, 274, 279, 76, 18
    CONTROL "폴더 선택…", IDC_REFRESH_FOLDER, "Button", BS_OWNERDRAW | WS_TABSTOP, 356, 279, 76, 18
    CONTROL "실패 상세…", IDC_REFRESH_DETAILS, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED, 274, 303, 76, 18
    CONTROL "갱신 중단", IDC_CANCEL_REFRESH, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED, 356, 303, 76, 18

    LTEXT "DMIND  ·  dmind114@gmail.com", IDC_CONTACT, 18, 359, 240, 10
    COMBOBOX IDC_LANGUAGE, 384, 11, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "닫기", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 376, 355, 68, 18
END
