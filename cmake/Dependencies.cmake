set(THUMBNAIL_DEPS "${CMAKE_SOURCE_DIR}/.deps")
set(OCCT_ROOT "${THUMBNAIL_DEPS}/occt-minimal")
set(LIB3MF_ROOT "${THUMBNAIL_DEPS}/lib3mf/lib3mf-2.5.0-Windows")
set(ASSIMP_SOURCE "${THUMBNAIL_DEPS}/assimp-source/assimp-6.0.5")
foreach(required "${OCCT_ROOT}/include/STEPControl_Reader.hxx" "${LIB3MF_ROOT}/lib/lib3mf.lib" "${ASSIMP_SOURCE}/CMakeLists.txt")
    if(NOT EXISTS "${required}")
        message(FATAL_ERROR "Missing dependency: ${required}. Run scripts/setup-dependencies.ps1 and scripts/build-occt.ps1 first.")
    endif()
endforeach()

add_library(thumbnail_occt INTERFACE)
target_include_directories(thumbnail_occt SYSTEM INTERFACE "${OCCT_ROOT}/include")
set(OCCT_LINK_LIBRARIES TKDESTEP TKDEIGES TKXSBase TKShHealing TKTopAlgo TKBRep TKGeomBase
    TKGeomAlgo TKG2d TKG3d TKMath TKernel TKMesh TKPrim TKBO TKBool)
foreach(library IN LISTS OCCT_LINK_LIBRARIES)
    target_link_libraries(thumbnail_occt INTERFACE "${OCCT_ROOT}/lib/${library}.lib")
endforeach()

add_library(thumbnail_lib3mf INTERFACE)
target_include_directories(thumbnail_lib3mf SYSTEM INTERFACE "${LIB3MF_ROOT}/include/Bindings/Cpp")
target_link_libraries(thumbnail_lib3mf INTERFACE "${LIB3MF_ROOT}/lib/lib3mf.lib")

# Compile only the mesh importers used by the product.
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_ASSIMP_TOOLS OFF CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_SAMPLES OFF CACHE BOOL "" FORCE)
set(ASSIMP_INSTALL OFF CACHE BOOL "" FORCE)
set(ASSIMP_INSTALL_PDB OFF CACHE BOOL "" FORCE)
set(ASSIMP_WARNINGS_AS_ERRORS OFF CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_ALL_IMPORTERS_BY_DEFAULT OFF CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_OBJ_IMPORTER ON CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_PLY_IMPORTER ON CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_GLTF_IMPORTER ON CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_FBX_IMPORTER ON CACHE BOOL "" FORCE)
set(ASSIMP_NO_EXPORT ON CACHE BOOL "" FORCE)
set(ASSIMP_BUILD_ZLIB ON CACHE BOOL "" FORCE)
add_subdirectory("${ASSIMP_SOURCE}" "${CMAKE_BINARY_DIR}/dependencies/assimp" EXCLUDE_FROM_ALL)
